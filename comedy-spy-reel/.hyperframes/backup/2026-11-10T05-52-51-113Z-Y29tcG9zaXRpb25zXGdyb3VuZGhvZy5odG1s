        ticket(g,765,701,.65,-.12);g.restore();
      }else if(kind==='outro'){
        for(let k=0;k<5;k++){const land=ease((t-k*.10)/.35);bar(g,155+(1-land)*(k%2?1050:-1050),555+k*112,748,96,k%2?C.ink:C.paper,-.025+k*.008,130+k);}
